# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.

# --- Base de datos ---------------------------------------------------------
# En desarrollo `npm run dev` levanta un PostgreSQL embebido en este puerto.
DEV_DB_PORT=54329
# Conexión de la API (rol sin privilegios, sujeto a Row Level Security).
DATABASE_URL=postgres://brisas_app:brisas_app_dev@localhost:54329/brisas
# Conexión administrativa: solo para migraciones y seeds.
DATABASE_ADMIN_URL=postgres://postgres:postgres_dev@localhost:54329/brisas
# Contraseña que las migraciones asignan al rol brisas_app.
APP_DB_PASSWORD=brisas_app_dev

# --- API -------------------------------------------------------------------
API_PORT=4000
WEB_URL=http://localhost:3000
# Genera cada secreto con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-este-secreto-de-desarrollo-por-uno-aleatorio-largo
# Clave de 32 bytes en base64 para cifrar secretos MFA en reposo.
DATA_ENCRYPTION_KEY=ZGVzYXJyb2xsby1sb2NhbC1jbGF2ZS0zMi1ieXRlcyE=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Exigir MFA a administradores (recomendado true en producción).
MFA_REQUIRED_FOR_ADMINS=false

# --- Correo ----------------------------------------------------------------
# log = imprime el correo en consola (desarrollo) | resend = envía con Resend
MAIL_TRANSPORT=log
MAIL_FROM="Brisas <no-responder@example.com>"
RESEND_API_KEY=

# --- Web -------------------------------------------------------------------
# URL interna de la API a la que Next.js redirige /api/*
API_INTERNAL_URL=http://localhost:4000
